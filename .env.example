# PostgreSQL configuration
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db
POSTGRES_PORT=5432
POSTGRES_URL="postgres:${POSTGRES_PORT}"

# Used in compose.override.yaml and conpose.prod.yaml
PGDATA=/var/lib/postgresql/data/pgdata

# Used for configuring connection to database in Metadata and Users services
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_URL}/${POSTGRES_DB}?sslmode=disable"

# Host port for compose.override.yaml
POSTGRES_HOST_PORT=5430

# Redis configuration
REDIS_PORT=6379
REDIS_HOST=redis

# Used for configuring connection to Redis in Metadata service
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}/0"

# Host port for compose.override.yaml
REDIS_HOST_PORT=6379

# Web frontend port on host 
WEB_PORT=3000

GATEWAY_PORT=8080
GATEWAY_URL="http://gateway:80"

LOG_LEVEL=DEBUG

# Database migrations directory
MIGRATIONS_DIRECTORY=file://migrations/metadata
